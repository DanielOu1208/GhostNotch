#!/usr/bin/env python3
import argparse
import json
import os
import pathlib
import sys
import tempfile


VALID_STATES = {"idle", "working", "attention"}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Write GhostNotch agent activity state.")
    parser.add_argument("state", choices=sorted(VALID_STATES))
    parser.add_argument(
        "--when-field",
        action="append",
        default=[],
        metavar="FIELD=VALUE[,VALUE...]",
        help="Only write state when stdin JSON contains FIELD with one of the values.",
    )
    return parser.parse_args()


def should_write_state(filters: list[str]) -> bool:
    if not filters:
        return True

    try:
        payload = json.load(sys.stdin)
    except Exception:
        return False

    for field_filter in filters:
        field, separator, raw_values = field_filter.partition("=")
        if not separator:
            return False

        expected_values = {value.strip() for value in raw_values.split(",") if value.strip()}
        if payload.get(field) not in expected_values:
            return False

    return True


def write_state(state_file: pathlib.Path, state: str) -> None:
    state_file.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w",
        encoding="utf-8",
        dir=state_file.parent,
        prefix=f".{state_file.name}.",
        delete=False,
    ) as temporary_file:
        temporary_file.write(f"{state}\n")
        temporary_path = pathlib.Path(temporary_file.name)

    temporary_path.replace(state_file)


def main() -> int:
    args = parse_args()
    state_file = os.environ.get("GHOSTNOTCH_AGENT_STATE_FILE")
    if not state_file:
        return 0

    if not should_write_state(args.when_field):
        return 0

    write_state(pathlib.Path(state_file), args.state)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
