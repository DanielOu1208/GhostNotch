#!/usr/bin/env python3
import argparse
import datetime as dt
import json
import os
import pathlib
import select
import sys
import tempfile


VALID_AGENTS = {"codex", "claude", "opencode"}
VALID_STATES = {"idle", "working", "attention"}
SAFE_PAYLOAD_VALUE_FIELDS = {"hook_event_name", "notification_type", "tool_name"}


def utc_timestamp() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Write GhostNotch agent activity state.")
    parser.add_argument("--agent", choices=sorted(VALID_AGENTS), required=False)
    parser.add_argument("--event", required=False)
    parser.add_argument("--state", choices=sorted(VALID_STATES), required=False)
    parser.add_argument(
        "--when-field",
        action="append",
        default=[],
        metavar="FIELD=VALUE[,VALUE...]",
        help="Only write state when stdin JSON contains FIELD with one of the values.",
    )
    parser.add_argument("--self-test", action="store_true")
    return parser.parse_args()


def read_hook_payload() -> dict:
    try:
        if sys.stdin.closed or not select.select([sys.stdin], [], [], 0)[0]:
            return {}
        raw_payload = sys.stdin.read()
    except Exception:
        return {}

    if not raw_payload.strip():
        return {}

    try:
        payload = json.loads(raw_payload)
    except Exception:
        return {}

    return payload if isinstance(payload, dict) else {}


def should_write_state(payload: dict, filters: list[str]) -> bool:
    for field_filter in filters:
        field, separator, raw_values = field_filter.partition("=")
        if not separator:
            return False

        expected_values = {value.strip() for value in raw_values.split(",") if value.strip()}
        if payload.get(field) not in expected_values:
            return False

    return True


def safe_payload_metadata(payload: dict) -> dict:
    payload_keys = sorted(str(key) for key in payload.keys())
    payload_types = {
        str(key): type(value).__name__
        for key, value in payload.items()
    }
    payload_values = {
        str(key): value
        for key, value in payload.items()
        if str(key) in SAFE_PAYLOAD_VALUE_FIELDS and isinstance(value, (str, int, float, bool))
    }

    return {
        "payloadKeys": payload_keys,
        "payloadTypes": payload_types,
        "payloadValues": payload_values,
    }


def state_envelope(agent: str, event: str, state: str, payload: dict) -> dict:
    envelope = {
        "version": 1,
        "agent": agent,
        "state": state,
        "event": event,
        "timestamp": utc_timestamp(),
    }
    envelope.update(safe_payload_metadata(payload))
    return envelope


def write_json_atomic(path: pathlib.Path, envelope: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w",
        encoding="utf-8",
        dir=path.parent,
        prefix=f".{path.name}.",
        delete=False,
    ) as temporary_file:
        json.dump(envelope, temporary_file, sort_keys=True)
        temporary_file.write("\n")
        temporary_path = pathlib.Path(temporary_file.name)

    temporary_path.replace(path)


def append_event_log(path: pathlib.Path, envelope: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as log_file:
        json.dump(envelope, log_file, sort_keys=True)
        log_file.write("\n")


def run_self_test() -> None:
    payload = {
        "hook_event_name": "UserPromptSubmit",
        "notification_type": "permission_prompt",
        "prompt": "do not log this",
        "command": "do not log this either",
        "nested": {"secret": "value"},
    }
    codex_envelope = state_envelope("codex", "UserPromptSubmit", "working", payload)
    claude_envelope = state_envelope("claude", "Notification", "attention", payload)
    opencode_envelope = state_envelope("opencode", "session.status", "working", payload)
    serialized = json.dumps([codex_envelope, claude_envelope, opencode_envelope], sort_keys=True)

    assert codex_envelope["agent"] == "codex"
    assert codex_envelope["state"] == "working"
    assert claude_envelope["agent"] == "claude"
    assert claude_envelope["state"] == "attention"
    assert opencode_envelope["agent"] == "opencode"
    assert opencode_envelope["state"] == "working"
    assert codex_envelope["payloadKeys"] == ["command", "hook_event_name", "nested", "notification_type", "prompt"]
    assert codex_envelope["payloadTypes"]["nested"] == "dict"
    assert codex_envelope["payloadValues"] == {
        "hook_event_name": "UserPromptSubmit",
        "notification_type": "permission_prompt",
    }
    assert should_write_state(payload, ["notification_type=permission_prompt,idle_prompt"])
    assert not should_write_state(payload, ["notification_type=other"])
    assert not should_write_state(payload, ["malformed-filter"])
    assert "do not log this" not in serialized
    assert "do not log this either" not in serialized
    assert "secret" not in serialized
    assert "value" not in serialized

    with tempfile.TemporaryDirectory() as directory:
        state_path = pathlib.Path(directory) / "state.json"
        log_path = pathlib.Path(directory) / "events.jsonl"
        write_json_atomic(state_path, codex_envelope)
        append_event_log(log_path, codex_envelope)
        append_event_log(log_path, claude_envelope)
        assert json.loads(state_path.read_text(encoding="utf-8"))["agent"] == "codex"
        assert len(log_path.read_text(encoding="utf-8").splitlines()) == 2


def main() -> int:
    args = parse_args()
    if args.self_test:
        run_self_test()
        return 0

    if not args.agent or not args.event or not args.state:
        raise SystemExit("--agent, --event, and --state are required unless --self-test is used")

    state_file = os.environ.get("GHOSTNOTCH_AGENT_STATE_FILE")
    if not state_file:
        return 0

    payload = read_hook_payload()
    if not should_write_state(payload, args.when_field):
        return 0

    envelope = state_envelope(args.agent, args.event, args.state, payload)
    write_json_atomic(pathlib.Path(state_file), envelope)

    event_log = os.environ.get("GHOSTNOTCH_AGENT_EVENT_LOG")
    if event_log:
        append_event_log(pathlib.Path(event_log), envelope)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
