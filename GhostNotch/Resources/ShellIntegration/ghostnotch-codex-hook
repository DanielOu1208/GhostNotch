#!/usr/bin/env python3
import os
import pathlib
import sys


def main() -> int:
    shared_helper = pathlib.Path(__file__).with_name("ghostnotch-agent-hook")
    arguments = [sys.executable, str(shared_helper)]
    if "--self-test" not in sys.argv[1:]:
        arguments.extend(["--agent", "codex"])
    arguments.extend(sys.argv[1:])
    os.execv(sys.executable, arguments)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
