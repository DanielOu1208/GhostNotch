{
  "id": "codex",
  "packageVersion": 1,
  "displayName": "Codex CLI",
  "binaryName": "codex",
  "defaultConfigPath": "~/.codex/hooks.json",
  "helperName": "ghostnotch-agent-hook",
  "legacyHelperNames": [
    "ghostnotch-agent-state",
    "ghostnotch-codex-hook"
  ],
  "hooks": [
    {
      "event": "SessionStart",
      "state": "idle"
    },
    {
      "event": "UserPromptSubmit",
      "state": "working"
    },
    {
      "event": "PreToolUse",
      "matcher": "*",
      "state": "working"
    },
    {
      "event": "PostToolUse",
      "matcher": "*",
      "state": "working"
    },
    {
      "event": "PermissionRequest",
      "matcher": "*",
      "state": "attention"
    },
    {
      "event": "Stop",
      "state": "idle"
    }
  ]
}
