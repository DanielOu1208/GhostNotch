{
  "id": "claude",
  "packageVersion": 1,
  "displayName": "Claude Code",
  "binaryName": "claude",
  "defaultConfigPath": "~/.claude/settings.json",
  "helperName": "ghostnotch-agent-hook",
  "legacyHelperNames": [
    "ghostnotch-agent-state"
  ],
  "hooks": [
    {
      "event": "SessionStart",
      "state": "idle"
    },
    {
      "event": "UserPromptSubmit",
      "state": "working"
    },
    {
      "event": "PreToolUse",
      "matcher": "*",
      "state": "working"
    },
    {
      "event": "PostToolUse",
      "matcher": "*",
      "state": "working"
    },
    {
      "event": "PostToolUseFailure",
      "matcher": "*",
      "state": "working"
    },
    {
      "event": "Stop",
      "state": "idle"
    },
    {
      "event": "StopFailure",
      "state": "idle"
    },
    {
      "event": "SessionEnd",
      "state": "idle"
    },
    {
      "event": "PermissionRequest",
      "matcher": "*",
      "state": "attention"
    },
    {
      "event": "Notification",
      "state": "attention",
      "whenField": "notification_type=permission_prompt,elicitation_dialog"
    },
    {
      "event": "Elicitation",
      "matcher": "*",
      "state": "attention"
    },
    {
      "event": "ElicitationResult",
      "matcher": "*",
      "state": "working"
    }
  ]
}
